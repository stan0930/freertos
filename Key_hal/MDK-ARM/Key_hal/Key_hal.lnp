"key_hal\stm32f1xx_hal.o"
"key_hal\stm32f1xx_hal_rcc.o"
"key_hal\stm32f1xx_hal_rcc_ex.o"
"key_hal\stm32f1xx_hal_gpio.o"
"key_hal\stm32f1xx_hal_dma.o"
"key_hal\stm32f1xx_hal_cortex.o"
"key_hal\stm32f1xx_hal_pwr.o"
"key_hal\stm32f1xx_hal_flash.o"
"key_hal\stm32f1xx_hal_flash_ex.o"
